<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>de.dominikschadow.javasecurity</groupId>
        <artifactId>javasecurity</artifactId>
        <version>4.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>security-header</artifactId>
    <packaging>war</packaging>
    <name>Security Header</name>

    <description>Security Response Header sample project. Sets different security related response headers via filter
        classes to each response. After launching, open the web application in your browser at
        http://localhost:8080/security-header or https://localhost:8443/security-header
    </description>

    <dependencies>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>package cargo:run</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.codehaus.cargo</groupId>
                <artifactId>cargo-maven3-plugin</artifactId>
                <configuration>
                    <configuration>
                        <!-- custom server.xml with HTTP (8080) and HTTPS (8443) connectors -->
                        <configfiles>
                            <configfile>
                                <file>${project.basedir}/src/main/tomcat/server.xml</file>
                                <todir>conf</todir>
                            </configfile>
                            <configfile>
                                <file>${project.basedir}/certificates/keystore.p12</file>
                                <todir>conf</todir>
                            </configfile>
                        </configfiles>
                    </configuration>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>